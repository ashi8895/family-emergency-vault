# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/family-emergency-vault
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PRELOGIN_SECRET=
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# Optional: send invite emails. Example (Gmail app password): smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com
# Leave empty to print invite links in the server console instead.
SMTP_URL=
MAIL_FROM=Family Emergency Vault <you@gmail.com>

# Demo mode: make the safety switch run fast. 60000 means "1 day" = 1 minute. Never use in production.
# TIME_UNIT_MS=60000
# SCHEDULER_TICK_MS=10000

# Production hosting. See docs/deploy.md.
# STORAGE=gridfs       # keep encrypted files inside MongoDB (needed when the host disk is not permanent)
# TRUST_PROXY=1        # 1 when behind Render / Railway / Nginx, so rate limits and the audit log see real visitor IPs
